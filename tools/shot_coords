#!/usr/bin/env python3
"""World coordinates of a qwe screenshot, read off the HUD printed in it.

The point inspector panel (top-right, directly under the telemetry —
`ui/inspector.rs::update_camera_text`) begins with a line `zoom/x/y cx/cy`: the camera
centre in map metres, metres per logical pixel, and the point under the cursor (`-/-`
when the cursor is outside the window). That line is the only record of where *that*
frame was taken — `brp cam` answers where the camera is *now*, and the user has usually
moved it since.

    tools/shot_coords <png>                  # camera, cursor, the frame's extent in metres
    tools/shot_coords <png> 812 430 [x y …]  # + those image pixels in map metres
    tools/shot_coords <png> --window 1512x945

The png may be anything that contains the panel: a `brp shot` capture, its
`.small.png`, or — the usual case — a region the user grabbed with a macOS screenshot
utility, cropped anywhere, at 1× or 2×, with or without the title bar. The HUD itself is
the ruler: its monospace advance gives the image's px per logical px, and its fixed place
at the window's top-right corner gives where the window centre (= camera centre) falls in
the image, even when that centre is outside the crop. What the image cannot tell is the
window's logical size; it is asked from a running app over BRP and else taken as
1920×1080 — pass `--window` when the user's window differs.

The hits list under the camera line — the inspector's answer to "what is this" — is read
by the same OCR: one `z <depth> <label> [#<osm id>]` line per drawn layer under the
cursor. The row the user picked (`]`/`[` cycle; it carries the translucent-yellow row
background, `ui/inspector.rs::HIGHLIGHT_ROW_BG`) is the user's pointer when they send a
screenshot with a highlighted element: that hit — not the highlight overlay — is the
subject. Its `#id` goes straight into the printed `osm_near --id` hint.
"""

import argparse
import os
import re
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# mirrors `settings.rs::MAP_SIZE` — a sanity check on the OCR only, so a drift costs a
# wrong warning and nothing else; change it with that constant.
MAP_W, MAP_H = 7600.0, 5700.0

# The panel's geometry in logical px (the point inspector panel, `ui/inspector.rs`:
# edge offset 8, telemetry's own width 470, padding 16/10, FiraMono at SMALL_FONT).
# Measured on a 3840×2160 run at scale factor 2 — CHAR_ADVANCE off the text node's
# content size, the rest off `brp get <camera-text-node> ComputedNode UiGlobalTransform`
# (the node's translation is its *center*, in physical px) plus ~2.5 px of glyph ink.
# Changing the panel means re-measuring these: `tesseract <shot> - --psm 11 tsv`, or the
# same BRP read when the screen is occluded and captures come out black.
CHAR_ADVANCE = 7.2  # FiraMono 12 px
TEXT_LEFT_FROM_RIGHT = 461.5  # left ink edge of every panel line → window's right edge
CAMERA_LINE_TOP = 117.0  # top ink edge of the camera line → window's top edge
# Monospace columns of the fixed words in the lines above, counted from the line start
# (`update_pathfinding_text`'s format string: every number is right-padded to a fixed width,
# so these never move). The ruler is the longest start → word distance that got read.
COLUMNS = {
    "pathfinding:": {"in": 18, "flight,": 21, "queued,": 35, "ms": 49, "avg": 52},
    "answers:": {"failed": 30},
    "entities:": {"tick": 18, "ms": 37, "wait": 40, "(pk": 45},
}

# unanchored at the start: OCR sometimes glues a stray glyph in front of the zoom
CAMERA = re.compile(r"(\S)\.(\d+)/(\d+)/(\d+)$")
CURSOR = re.compile(r"^(?:(\d+)/(\d+)|-/-)$")
# a hits line: `z`, the padded depth, then the label words (`format_hits`); OCR
# reads the z as `Zz`, `zz`, sometimes a stray glyph in front — anything z-ish
HITS_Z = re.compile(r"^\S?[zZ]{1,2}$")
HITS_DEPTH = re.compile(r"^\d\.\d{1,3}$")
HITS_ID = re.compile(r"^#(\d{6,})$")

# the selected row's background is 18% yellow over the panel (`HIGHLIGHT_ROW_BG`),
# the resting rows are the bare panel — the difference reads as (r+g)/2 − b of the
# pixel sampled past the row's text. Calibrated on a 2× capture; a 1× one samples
# the same blend, only coarser.
SELECTED_MARGIN = 8
SELECTED_FLOOR = 12


def words(png, upscale):
    """Tesseract word boxes, in the png's own pixel coordinates."""
    with tempfile.TemporaryDirectory() as tmp:
        prepared = os.path.join(tmp, "ocr.png")
        cmd = ["magick", png, "-colorspace", "Gray"]
        if upscale != 1:
            cmd += ["-resize", f"{upscale * 100:.0f}%"]
        subprocess.run(cmd + [prepared], check=True, capture_output=True)
        tsv = subprocess.run(
            ["tesseract", prepared, "-", "--psm", "11", "tsv"], capture_output=True, text=True
        ).stdout
    found = []
    for row in tsv.splitlines()[1:]:
        cols = row.split("\t")
        if len(cols) < 12 or not cols[11].strip():
            continue
        # a slashed or dotted zero comes back as © / @ / O / o
        text = re.sub(r"(?<=[\d/.])[©@Oo]|[©@Oo](?=[\d/.])", "0", cols[11].strip())
        left, top, width, height = (int(c) / upscale for c in cols[6:10])
        found.append({"text": text, "left": left, "top": top, "w": width, "h": height})
    return found


def same_line(word, anchor):
    return abs(word["top"] - anchor["top"]) < anchor["h"] and word["left"] > anchor["left"]


def window_size(explicit):
    if explicit:
        w, h = explicit.lower().split("x")
        return float(w), float(h), "--window"
    brp = os.path.join(ROOT, ".claude/skills/live-app/scripts/brp")
    for port in ("15702", "15703"):
        try:
            out = subprocess.run(
                [brp, "window"],
                capture_output=True,
                text=True,
                timeout=5,
                env={**os.environ, "BRP_PORT": port, "BRP_TIMEOUT": "2"},
            ).stdout
        except (OSError, subprocess.TimeoutExpired):
            continue
        match = re.search(r"logical=(\d+)x(\d+)", out)
        if match:
            return float(match[1]), float(match[2]), f"brp window on :{port}"
    return 1920.0, 1080.0, "default — no app answered, pass --window if it differs"


def pixel_rgb(png, x, y):
    """One pixel as (r, g, b), 0–255."""
    out = subprocess.run(
        ["magick", png, "-format", f"%[pixel:p{{{x:.0f},{y:.0f}}}]", "info:"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    channels = re.findall(r"[\d.]+", out)
    return tuple(float(c) for c in channels[:3])


def hits_lines(boxes, camera):
    """The hits list: lines of words below the camera line, `z <depth> …` ones only,
    each sorted left→right. The checkbox row and anything OCR failed on don't match."""
    height = camera["h"]
    below = sorted(
        (w for w in boxes if w["top"] > camera["top"] + height * 0.9),
        key=lambda w: (w["top"], w["left"]),
    )
    lines = []
    for word in below:
        for line in lines:
            if abs(line[0]["top"] - word["top"]) < height * 0.6:
                line.append(word)
                break
        else:
            lines.append([word])
    hits = []
    for line in lines:
        line.sort(key=lambda w: w["left"])
        # OCR glues stray glyphs into the row (sometimes far left of the panel),
        # so look for the z + depth pair anywhere in the line, not at its head
        if any(
            HITS_Z.match(word["text"]) and HITS_DEPTH.match(line[i + 1]["text"])
            for i, word in enumerate(line[:-1])
        ):
            hits.append(line)
    return hits


def print_hits(png, lines, scale):
    """The hits list with the picked row marked; (was anything picked, its #id or None)."""
    if not lines:
        return False, None
    yellowness = []
    for line in lines:
        last = line[-1]
        r, g, b = pixel_rgb(png, last["left"] + last["w"] + 8 * scale, line[0]["top"] + line[0]["h"] / 2)
        yellowness.append((r + g) / 2 - b)
    picked = max(range(len(lines)), key=lambda i: yellowness[i])
    ranks = sorted(yellowness, reverse=True)
    if ranks[0] < SELECTED_FLOOR or (len(ranks) > 1 and ranks[0] - ranks[1] < SELECTED_MARGIN):
        picked = None
    print("hits (top of the list first):")
    picked_id = None
    for index, line in enumerate(lines):
        # the row's own words start at its z; whatever OCR glued in front is noise,
        # and the z itself comes back as `Zz`/`zz` — print it as the z it is
        start = next(
            (i for i, word in enumerate(line[:-1]) if HITS_Z.match(word["text"]) and HITS_DEPTH.match(line[i + 1]["text"])),
            0,
        )
        text = "z " + " ".join(w["text"] for w in line[start + 1 :])
        mark = ""
        if index == picked:
            mark = "   <- selected (the highlight draws this one)"
            for word in line:
                if HITS_ID.match(word["text"]):
                    picked_id = HITS_ID.match(word["text"])[1]
        print(f"  {text}{mark}")
    return True, picked_id


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("png")
    parser.add_argument("pixels", nargs="*", type=float, help="x y pairs, image px")
    parser.add_argument("--window", help="window logical size WxH (`brp window`)")
    args = parser.parse_args()
    if len(args.pixels) % 2:
        sys.exit("pixels come in x y pairs")

    size = subprocess.run(
        ["magick", "identify", "-format", "%w %h", args.png],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.split()
    img_w, img_h = float(size[0]), float(size[1])
    # small text OCRs badly; a 1× capture of 12 px glyphs wants upscaling
    boxes = words(args.png, 1 if img_w >= 2500 else 2)

    camera = next((w for w in boxes if CAMERA.search(w["text"])), None)
    if not camera:
        sys.exit(
            f"no `zoom/x/y` word found in {args.png} — is the point inspector panel "
            "(top-right, under the telemetry) in the picture? If it is, crop it "
            "(`magick <png> -crop WxH+X+Y +repage`) and Read"
        )
    lead, frac, cam_x, cam_y = CAMERA.search(camera["text"]).groups()
    # the zoom's leading zero is the glyph OCR misreads most
    zoom = float(f"{lead if lead.isdigit() else '0'}.{frac}")
    cam_x, cam_y = float(cam_x), float(cam_y)
    cursor = next(
        (CURSOR.match(w["text"]) for w in boxes if same_line(w, camera) and CURSOR.match(w["text"])),
        None,
    )

    # scale: the longest run of monospace columns between a line's first word and a
    # fixed word of the same line, else the camera word's own ink width (±5%)
    ruler = None
    for start in boxes:
        for word in boxes:
            column = COLUMNS.get(start["text"], {}).get(word["text"])
            if column and same_line(word, start) and (not ruler or column > ruler[0]):
                ruler = (column, (word["left"] - start["left"]) / (column * CHAR_ADVANCE))
                ruler_from = f"{column} columns {start['text']} → {word['text']}"
    if ruler:
        scale, scale_from = ruler[1], ruler_from
    else:
        scale = camera["w"] / ((len(camera["text"]) - 0.4) * CHAR_ADVANCE)
        scale_from = "camera word width, ±5%"
    win_w, win_h, win_from = window_size(args.window)

    # the window's top-right corner, then its centre, in image px
    right = camera["left"] + TEXT_LEFT_FROM_RIGHT * scale
    top = camera["top"] - CAMERA_LINE_TOP * scale
    centre_x, centre_y = right - win_w / 2 * scale, top + win_h / 2 * scale
    metres_per_px = zoom / scale

    def world(px, py):
        return cam_x + (px - centre_x) * metres_per_px, cam_y - (py - centre_y) * metres_per_px

    print(f"hud: {camera['text']} {cursor[0] if cursor else '(cursor word unread)'}")
    print(
        f"camera centre: {cam_x:.0f}, {cam_y:.0f}   zoom {zoom} m per logical px "
        f"({len(frac)} decimals: ±{0.5 * 10 ** -len(frac) / zoom:.1%})"
    )
    if cursor and cursor[1]:
        print(f"cursor: {cursor[1]}, {cursor[2]}   (where the pointer was — often at the thing)")
    elif cursor:
        print("cursor: outside the window")
    if not (0 <= cam_x <= MAP_W and 0 <= cam_y <= MAP_H):
        print(f"!! camera outside the {MAP_W:.0f}×{MAP_H:.0f} map — OCR misread?")
    print(
        f"image: {img_w:.0f}×{img_h:.0f} px, {scale:.3f} px per logical px ({scale_from}); "
        f"window {win_w:.0f}×{win_h:.0f} ({win_from})"
    )
    print(f"camera centre is at image px {centre_x:.0f}, {centre_y:.0f}")
    (x0, y1), (x1, y0) = world(0, 0), world(img_w, img_h)
    print(
        f"image covers {x1 - x0:.0f}×{y1 - y0:.0f} m: x {x0:.0f}..{x1:.0f}, y {y0:.0f}..{y1:.0f}"
    )
    mid_x, mid_y = world(img_w / 2, img_h / 2)
    radius = max(15, round(min(x1 - x0, y1 - y0) / 2))
    picked, picked_id = print_hits(args.png, hits_lines(boxes, camera), scale)
    for px, py in zip(args.pixels[::2], args.pixels[1::2]):
        wx, wy = world(px, py)
        print(f"pixel ({px:.0f}, {py:.0f}) → world {wx:.1f}, {wy:.1f}")
    print(f"next: tools/osm_near {mid_x:.0f} {mid_y:.0f} {radius}   # the image's middle")
    if picked_id:
        print(f"next: tools/osm_near --id {picked_id}   # the selected hit's source element")
    elif picked and cursor and cursor[1]:
        # a generated feature (an auto band, a pocket) has no OSM element — the
        # cursor point is where it lives
        print(
            f"next: tools/osm_near {cursor[1]} {cursor[2]} 8   # around the cursor: the selected hit has no OSM id"
        )


if __name__ == "__main__":
    main()
