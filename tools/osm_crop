#!/usr/bin/env python3
"""Cut a window out of the cached Overpass extract — as an Overpass response of its own.

    tools/osm_crop --at 4646,1917 --half 120 out.json     # window centre in map metres
    tools/osm_crop --geo 54.18386,37.61345 --half 120 out.json
    tools/osm_crop --city tula --at 4646,1917 --half 120 out.json
    tools/osm_crop --manifest examples/demos/roads/data/tula.json   # every sample it lists

With `--manifest` each sample is cut `--margin` metres (120) wider than its visible `half`.
The gallery clips what it draws to the visible window, so the rim is never seen — it is
there for what the pipeline *reads* around a point: the row a house is pulled back with,
the road a lot is paved up to, the quarter the parked cars take their density from
(`cars::district`, 120 m). A sample placed by `"at": [x, y]` gets its `"geo": [lat, lon]`
written back in place of it — that is how a new sample is added: find the node with
`tools/osm_near`, put `at` in the manifest, run this.

The output is what `map::osm::parse::parse` eats: the same `elements` with `out geom`
geometry and every original tag, only fewer of them. It is how the samples of
`examples/demos/roads/data/` are made — a junction of the real city as a file small
enough to read, so the whole way from OSM data to pixels can be followed on one crossing.

What the cut does to each kind of element:

- node — kept when inside the window;
- way — kept **whole** when it touches the window, never clipped. The pipeline keys on a
  way's own points: a street's first point seeds its row of parked cars, a lot's outline
  decides its stall layout, a shared vertex decides whether a house may be squared — a
  clipped way is a different way, and the sample stops looking like the game;
- multipolygon relation — a building is kept whole; otherwise (a river, a park — these
  run for kilometres) its rings are assembled, clipped as polygons and written back as
  closed members of the same role;
- the tag-only relations of the `is_in` output (the country boundary that carries
  `driving_side`) — kept, with their hundreds of `name:*` tags dropped.

Prints the window centre both ways (map metres and lat/lon) — the lat/lon pair is what
the gallery's sample table stores, since map metres move with `MAP_SIZE`.
"""

import argparse
import glob
import json
import math
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
METERS_PER_DEG_LAT = 111_320.0
KEPT_BOUNDARY_TAGS = ("name", "admin_level", "boundary", "driving_side", "ISO3166-1", "type")


def cache_file(city):
    files = sorted(glob.glob(os.path.join(ROOT, "assets/osm", f"{city or ''}*.json")))
    files = [f for f in files if re.search(r"_[\d.]+_[\d.]+_\d+x\d+_v\d+\.json$", f)]
    if not files:
        sys.exit(f"no OSM cache in assets/osm for {city or 'any city'} — run the app once")
    cities = {os.path.basename(f).split("_")[0] for f in files}
    if len(cities) > 1:
        sys.exit(f"several cities cached ({', '.join(sorted(cities))}) — pass --city")
    return max(files, key=lambda f: int(re.search(r"_v(\d+)\.json$", f)[1]))


class Frame:
    """The projection of `GeoBounds`, from the numbers in the cache file name."""

    def __init__(self, path):
        lat, lon, w, h = map(float, re.search(r"_([\d.]+)_([\d.]+)_(\d+)x(\d+)_v", path).groups())
        self.lon_scale = METERS_PER_DEG_LAT * math.cos(math.radians(lat))
        self.west = lon - w / 2 / self.lon_scale
        self.south = lat - h / 2 / METERS_PER_DEG_LAT

    def project(self, lat, lon):
        return (lon - self.west) * self.lon_scale, (lat - self.south) * METERS_PER_DEG_LAT

    def unproject(self, x, y):
        return self.south + y / METERS_PER_DEG_LAT, self.west + x / self.lon_scale


# --- geometry: everything below works on (lon, lat) pairs against a lon/lat box ---


def inside(p, box):
    return box[0] <= p[0] <= box[2] and box[1] <= p[1] <= box[3]


def clip_segment(a, b, box):
    """Liang–Barsky: the part of a–b inside the box as (t0, t1), or None."""
    t0, t1 = 0.0, 1.0
    dx, dy = b[0] - a[0], b[1] - a[1]
    for p, q in ((-dx, a[0] - box[0]), (dx, box[2] - a[0]), (-dy, a[1] - box[1]), (dy, box[3] - a[1])):
        if p == 0:
            if q < 0:
                return None
            continue
        t = q / p
        if p < 0:
            t0 = max(t0, t)
        else:
            t1 = min(t1, t)
        if t0 > t1:
            return None
    return t0, t1


def lerp(a, b, t):
    return (round(a[0] + (b[0] - a[0]) * t, 7), round(a[1] + (b[1] - a[1]) * t, 7))


def clip_line(points, box):
    """Pieces of a polyline inside the box. Original vertices stay bit for bit — shared
    nodes are found by equal coordinates, and only the cut ends are new points."""
    pieces, current = [], []
    for a, b in zip(points, points[1:]):
        span = clip_segment(a, b, box)
        if span is None:
            if len(current) >= 2:
                pieces.append(current)
            current = []
            continue
        t0, t1 = span
        start = a if t0 == 0.0 else lerp(a, b, t0)
        end = b if t1 == 1.0 else lerp(a, b, t1)
        if not current:
            current = [start]
        elif current[-1] != start:
            if len(current) >= 2:
                pieces.append(current)
            current = [start]
        if end != current[-1]:
            current.append(end)
        if t1 < 1.0:
            if len(current) >= 2:
                pieces.append(current)
            current = []
    if len(current) >= 2:
        pieces.append(current)
    return pieces


def clip_ring(ring, box):
    """Sutherland–Hodgman against the four sides. `ring` is open (no repeated point)."""
    sides = (
        (lambda p: p[0] >= box[0], 0, box[0]),
        (lambda p: p[0] <= box[2], 0, box[2]),
        (lambda p: p[1] >= box[1], 1, box[1]),
        (lambda p: p[1] <= box[3], 1, box[3]),
    )
    for keep, axis, value in sides:
        if not ring:
            break
        out = []
        for a, b in zip(ring, ring[1:] + ring[:1]):
            if keep(a) != keep(b):
                t = (value - a[axis]) / (b[axis] - a[axis])
                cut = lerp(a, b, t)
                cut = (value, cut[1]) if axis == 0 else (cut[0], value)
                if keep(a):
                    out += [a, cut]
                else:
                    out.append(cut)
            elif keep(a):
                out.append(a)
        ring = [p for i, p in enumerate(out) if p != out[i - 1]]
    return ring if len(ring) >= 3 else []


def bounds_of(points):
    xs, ys = [p[0] for p in points], [p[1] for p in points]
    return min(xs), min(ys), max(xs), max(ys)


def fits(points, box):
    b = bounds_of(points)
    return box[0] <= b[0] and box[1] <= b[1] and b[2] <= box[2] and b[3] <= box[3]


def touches(points, box):
    return bool(clip_line(points, box)) or any(inside(p, box) for p in points)


def assemble(segments):
    """Join relation members end to end into rings; an unclosed chain (cut by the edge
    of the city extract) is closed by force, as the parser does."""
    segments = [list(s) for s in segments if len(s) >= 2]
    rings = []
    while segments:
        ring = segments.pop()
        while ring[0] != ring[-1]:
            tail = ring[-1]
            index = next((i for i, s in enumerate(segments) if tail in (s[0], s[-1])), None)
            if index is None:
                break
            segment = segments.pop(index)
            if segment[0] != tail:
                segment.reverse()
            ring += segment[1:]
        if ring[0] == ring[-1]:
            ring.pop()
        if len(ring) >= 3:
            rings.append(ring)
    return rings


# --- elements ---


def pairs(geometry):
    return [(g["lon"], g["lat"]) for g in geometry]


def geometry_of(points):
    return [{"lat": lat, "lon": lon} for lon, lat in points]


def crop_way(element, box):
    points = pairs(element["geometry"])
    closed = len(points) >= 4 and points[0] == points[-1]
    # a block or a park may hold the whole window without its outline coming near it
    around = closed and bool(clip_ring(points[:-1], box))
    return [element] if around or touches(points, box) else []


def crop_relation(element, box):
    members = [m for m in element["members"] if m.get("type") == "way" and m.get("geometry")]
    lines = [pairs(m["geometry"]) for m in members]
    if "building" in element.get("tags", {}) or all(fits(line, box) for line in lines):
        return [element] if any(touches(line, box) for line in lines) else []
    # no `touches` gate here: water may hold the whole window inside its outline, and
    # `clip_ring` answers that case too — nothing left of the rings means no relation
    cropped = []
    for role in ("outer", "inner"):
        rings = assemble([line for m, line in zip(members, lines) if m.get("role") == role])
        for ring in rings:
            ring = clip_ring(ring, box)
            if ring:
                cropped.append({"type": "way", "role": role, "geometry": geometry_of(ring + ring[:1])})
    if not any(m["role"] == "outer" for m in cropped):
        return []
    return [{**{k: v for k, v in element.items() if k != "bounds"}, "members": cropped}]


def crop(element, box):
    kind = element["type"]
    if kind == "node":
        return [element] if inside((element["lon"], element["lat"]), box) else []
    if kind == "way":
        return crop_way(element, box) if element.get("geometry") else []
    if kind == "relation":
        if "members" in element:
            return crop_relation(element, box)
        tags = {k: v for k, v in element.get("tags", {}).items() if k in KEPT_BOUNDARY_TAGS}
        return [{**element, "tags": tags}]
    return []


def joining_roads(everything, kept):
    """Roads outside the window that share a node with a road inside it.

    A kept street is whole, so it runs on past the window — and the row of parked cars is
    walked along all of it, its RNG stream breaking at every junction on the way. Without
    the streets it meets out there those junctions do not exist, and the row inside the
    window comes out with other cars than the game parks. One level is enough: what is
    needed is the junctions *of the kept streets*, not their neighbours' neighbours."""
    roads = lambda elements: [
        e for e in elements if e["type"] == "way" and "highway" in e.get("tags", {}) and e.get("geometry")
    ]
    kept_ids = {e["id"] for e in roads(kept)}
    nodes = {point for e in roads(kept) for point in pairs(e["geometry"])}
    return [
        e for e in roads(everything)
        if e["id"] not in kept_ids and any(point in nodes for point in pairs(e["geometry"]))
    ]


def write_window(extract, frame, centre, half, out_path):
    """One window of the extract into `out_path`; `centre` is (x, y) in map metres."""
    x, y = centre
    south, west = frame.unproject(x - half, y - half)
    north, east = frame.unproject(x + half, y + half)
    box = (west, south, east, north)
    elements = [piece for element in extract["elements"] for piece in crop(element, box)]
    elements += joining_roads(extract["elements"], elements)

    head ={key: value for key, value in extract.items() if key != "elements"}
    # one element per line: the file is meant to be read and diffed
    lines = ",\n".join("    " + json.dumps(e, ensure_ascii=False) for e in elements)
    body = json.dumps(head, ensure_ascii=False, indent=2)[:-2]
    with open(out_path, "w", encoding="utf-8") as out:
        out.write(f'{body},\n  "elements": [\n{lines}\n  ]\n}}\n')

    counts = {kind: sum(1 for e in elements if e["type"] == kind) for kind in ("node", "way", "relation")}
    lat, lon = frame.unproject(x, y)
    print(f"{out_path}: {counts}")
    print(f"  centre {x:.0f},{y:.0f} m = {lat:.5f},{lon:.5f}  half {half:.0f} m")


def crop_manifest(manifest_path, extract, frame, margin):
    """Every sample of a gallery manifest. An entry placed by `at` (map metres) is
    rewritten to `geo`: metres move with `MAP_SIZE`, lat/lon does not."""
    with open(manifest_path, encoding="utf-8") as source:
        manifest = json.load(source)
    folder = os.path.join(os.path.dirname(manifest_path), manifest["folder"])
    os.makedirs(folder, exist_ok=True)
    for sample in manifest["samples"]:
        if "at" in sample:
            lat, lon = frame.unproject(*sample.pop("at"))
            sample["geo"] = [round(lat, 6), round(lon, 6)]
        centre = frame.project(*sample["geo"])
        write_window(extract, frame, centre, sample["half"] + margin, os.path.join(folder, sample["file"]))
    head = {key: value for key, value in manifest.items() if key != "samples"}
    lines = ",\n".join("    " + json.dumps(s, ensure_ascii=False) for s in manifest["samples"])
    body = json.dumps(head, ensure_ascii=False, indent=2)[:-2]
    with open(manifest_path, "w", encoding="utf-8") as out:
        out.write(f'{body},\n  "samples": [\n{lines}\n  ]\n}}\n')


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("out", nargs="?")
    parser.add_argument("--city")
    parser.add_argument("--at", help="window centre in map metres: x,y")
    parser.add_argument("--geo", help="window centre: lat,lon")
    parser.add_argument("--half", type=float, default=120.0, help="half side of the window, m")
    parser.add_argument("--manifest", help="a gallery manifest: crop every sample it lists")
    parser.add_argument("--margin", type=float, default=120.0,
                        help="with --manifest: metres cut beyond a sample's visible half")
    args = parser.parse_args()

    if args.manifest:
        with open(args.manifest, encoding="utf-8") as source:
            city = args.city or json.load(source)["city"]
        path = cache_file(city)
    else:
        if not args.out or bool(args.at) == bool(args.geo):
            sys.exit("pass an output file and exactly one of --at x,y and --geo lat,lon")
        path = cache_file(args.city)
    frame = Frame(path)
    with open(path, encoding="utf-8") as source:
        extract = json.load(source)
    print(f"from {os.path.basename(path)}")

    if args.manifest:
        crop_manifest(args.manifest, extract, frame, args.margin)
    elif args.at:
        write_window(extract, frame, tuple(map(float, args.at.split(","))), args.half, args.out)
    else:
        lat, lon = map(float, args.geo.split(","))
        write_window(extract, frame, frame.project(lat, lon), args.half, args.out)


if __name__ == "__main__":
    main()
